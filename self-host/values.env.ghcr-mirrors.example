# Optional overrides for third-party GHCR mirrors. Coturn already defaults to
# QAP's GHCR mirror; ensure each other package is public or credentials are set.
POSTGRES_IMAGE=ghcr.io/xuyooo/qap/cloudnative-pg-postgresql:16
GOTENBERG_IMAGE=ghcr.io/xuyooo/qap/gotenberg:8
COTURN_IMAGE=ghcr.io/xuyooo/qap/coturn:4.6
NFS_SERVER_IMAGE=ghcr.io/xuyooo/qap/nfs-server:2.2.3
RUNTIME_NODE_IMAGE=ghcr.io/xuyooo/qap/node:22-bookworm
RUNTIME_PYTHON_IMAGE=ghcr.io/xuyooo/qap/python:3.12-bookworm
RUNTIME_GOLANG_IMAGE=ghcr.io/xuyooo/qap/golang:1.23
PAUSE_IMAGE=ghcr.io/xuyooo/qap/pause:3.9
