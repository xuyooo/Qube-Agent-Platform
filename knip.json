{
  "workspaces": {
    "control-plane": {
      "entry": [
        "scripts/*.ts",
        "src/services/db/mcp-catalog.ts",
        "e2e/global-setup.ts",
        "e2e/setup.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "scripts/**/*.ts",
        "e2e/**/*.ts"
      ],
      "ignoreDependencies": [
        "tsx",
        "multiplex"
      ]
    },
    "web": {
      "entry": [
        "src/components/ui/**/*.{ts,tsx}",
        "src/components/workspace/file-preview/extend/**/*.{ts,tsx}",
        "src/**/*.test.{ts,tsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx,mdx}"
      ],
      "ignoreDependencies": [
        "@qap/theme",
        "@qap/ui-sdk"
      ]
    },
    "browser-service": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "channel-gateway": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "sandbox-service": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "scheduler": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "env-runner-k8s": {
      "project": [
        "src/**/*.ts"
      ],
      "ignoreDependencies": [
        "@kubernetes/client-node",
        "multiplex"
      ]
    },
    "skills-content-service": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "docs-site": {
      "entry": [
        "src/pages/**/*.{ts,astro}",
        "src/content/**/*.{md,mdx}",
        "src/components/**/*.{astro,ts,tsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx,astro,mjs}"
      ]
    },
    "internal/ui-sdk": {
      "entry": [
        "src/index.ts",
        "scripts/*.mjs",
        "tailwind.config.cjs"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "scripts/*.mjs"
      ],
      "ignoreDependencies": [
        "vitest"
      ]
    }
  },
  "ignore": [
    "agents/**",
    "packages/**",
    "internal/acp-adapter/**",
    "internal/agent-skills/**",
    "internal/agent-usage/**",
    "internal/client/**",
    "internal/dsh-adapter/**",
    "internal/env-runner-core/**",
    "internal/env-tunnel/**",
    "internal/k8s-provider/**",
    "internal/mcp-forward/**",
    "internal/oauth-client/**",
    "internal/platform-prompt/**",
    "internal/sse-consumer/**",
    "internal/theme/**",
    "internal/titlegen/**",
    "internal/types/**"
  ],
  "ignoreBinaries": [
    "wait",
    "tsc"
  ]
}
