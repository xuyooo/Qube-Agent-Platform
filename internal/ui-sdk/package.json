{
  "name": "@qap/ui-sdk",
  "version": "0.1.2",
  "description": "Qube Agent Platform shared UI SDK — reusable React components for embedding platform UI in third-party apps. First module: agent session transcript rendering (messages, tool calls) from the platform's wire message format. Host-agnostic: drop in with a locale, inject your own markdown if you have one.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/ui-sdk/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/ui-sdk/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": ["dist"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build",
    "test:host": "node scripts/test-host.mjs"
  },
  "license": "Apache-2.0",
  "peerDependencies": {
    "i18next": "^23.0.0 || ^24.0.0 || ^25.0.0",
    "lucide-react": "*",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-i18next": "^14.0.0 || ^15.0.0"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "diff": "^5.2.0",
    "tailwind-merge": "^2.5.0",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.19",
    "@types/diff": "^5.2.0",
    "@types/react": "^18.0.0",
    "esbuild": "0.25.12",
    "i18next": "^25.0.0",
    "lucide-react": "*",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-i18next": "^15.0.0",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "typescript": "~5.6.2"
  },
  "sideEffects": ["**/*.css"]
}
